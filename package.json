{
  "name": "@markup-carve/carve-skill",
  "version": "0.1.2",
  "description": "A Claude Code / agent authoring skill for Carve markup — teaches AI tools to write valid, idiomatic .crv the first time.",
  "keywords": [
    "carve",
    "markup",
    "djot",
    "claude-code",
    "skill",
    "agent",
    "authoring"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/markup-carve/carve-skill.git"
  },
  "bugs": "https://github.com/markup-carve/carve-skill/issues",
  "homepage": "https://github.com/markup-carve/carve-skill#readme",
  "type": "module",
  "private": true,
  "files": [
    "SKILL.md",
    "agents",
    "references",
    "scripts/check-installed-version.mjs"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "lint:examples": "node node_modules/@markup-carve/carve/dist/cli.js lint examples/*.crv",
    "test:behavior": "node --test test/behavior.test.mjs",
    "eval:tasks": "node scripts/task-evaluator.mjs",
    "context:measure": "node scripts/measure-context.mjs",
    "version:check": "node scripts/check-installed-version.mjs",
    "spec:check": "node scripts/check-spec-review.mjs",
    "spec:review": "node scripts/record-spec-review.mjs"
  },
  "devDependencies": {
    "@markup-carve/carve": "0.1.7",
    "gpt-tokenizer": "4.0.0"
  }
}
