{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "dialect": "Carve 0.2 freeze candidate",
  "status": "development on next2; not released",
  "spec": "markup-carve/carve next2 spec/0.2",
  "referenceEngine": "markup-carve/carve-js next2 v2",
  "cli": "node dist/cli2.js (installed name carve2)",
  "api": "v2/src/index.ts; package root remains 0.1",
  "html": true,
  "carveWriter": true,
  "htmlImport": true,
