{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "dialect": "Carve 0.2 freeze candidate",
  "status": "development on next2; not released",
  "spec": "markup-carve/carve next2 spec/0.2",
  "referenceEngine": "markup-carve/carve-js next2",
  "cli": "node dist/cli.js (installed name carve)",
  "api": "@markup-carve/carve (package root); entries ./node, ./import, ./export, ./extensions",
  "html": true,
  "carveWriter": true,
  "htmlImport": true,
  "astSchema": "2.0",
  "referenceOnly": ["upgrade", "Markdown/GFM/Djot/BBCode importers (@markup-carve/carve/import)", "Markdown/plain/ANSI exports (@markup-carve/carve/export)", "standard extensions (@markup-carve/carve/extensions)"],
  "removedFromShared02": ["Markdown writer", "plain writer", "ANSI writer", "0.1 editor APIs"],
  "hostDependent": ["raw HTML", "include resolver and root", "registered extensions", "URL policy"],
  "source": {
    "blocks": "spec/0.2/syntax-blocks.md",
    "inline": "spec/0.2/syntax-inline.md",
    "html": "spec/0.2/html.md",
    "ast": "spec/0.2/ast.md",
    "writer": "spec/0.2/writer.md",
    "includes": "spec/0.2/includes.md",
    "tooling": "spec/0.2/tooling.md",
    "extensions": "spec/0.2/extensions.md",
    "upgrade": "spec/0.2/UPGRADING.md",
    "lineShapes": "spec/0.2/data/line-shapes.json",
    "lintRules": "spec/0.2/data/lint-rules.json"
  }
}
